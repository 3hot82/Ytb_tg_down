# Telegram bot token from @BotFather. Never commit real tokens.
BOT_TOKEN=123456:replace_me

# Telegram admins, comma-separated numeric user IDs.
# Required for /login, /cookies and /cookies_export.
ADMIN_IDS=123456789

# Redis
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=media_jobs
# Drop stale queued jobs on worker start so old links do not start downloading after restart.
CLEAR_QUEUE_ON_WORKER_START=true

# Downloader limits.
# Cloud Telegram Bot API: keep MAX_FILE_MB around 50.
# Local Telegram Bot API server: can be raised, commonly up to ~2000.
MAX_FILE_MB=50
# YouTube video codec mode:
# - mp4  = H.264/AAC, best Telegram/iPhone compatibility, often larger.
# - av1  = AV1 video + AAC audio merged into MP4 without transcoding, much smaller, compatibility depends on client.
# - vp9  = VP9/Opus merged into WebM, compact but weaker Telegram compatibility.
# - auto = currently behaves like mp4.
VIDEO_CODEC_MODE=mp4

# YouTube preferred audio track.
# false = keep original/default audio behavior.
# true  = prefer YOUTUBE_AUDIO_LANGUAGE if YouTube exposes that track; if unavailable, fall back to original/default audio.
# For many dubbed YouTube videos, web_embedded exposes extra language tracks that the default client hides.
YOUTUBE_MULTI_AUDIO=false
YOUTUBE_AUDIO_LANGUAGE=ru
YOUTUBE_PLAYER_CLIENT=web_embedded

# SponsorBlock caption helper.
# false = do nothing.
# true  = do not cut/re-encode video; only add clickable "skip to end of segment" timestamps to Telegram caption.
# Categories: sponsor,selfpromo,interaction,intro,outro,preview,music_offtopic,filler
YOUTUBE_SPONSORBLOCK_CAPTION=false
YOUTUBE_SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,interaction

MAX_DURATION_SECONDS=600
DOWNLOAD_TIMEOUT_SECONDS=600
TELEGRAM_REQUEST_TIMEOUT_SECONDS=600
JOB_TTL_SECONDS=1800

# Queue limits.
# Multiple URLs in one message: max links to extract.
# Pending limits: bulkheads per chat and per user to prevent queue flooding.
# Each queued URL = one MediaJob. TTL cleans stale pending counters.
MAX_URLS_PER_MESSAGE=5
MAX_PENDING_JOBS_PER_CHAT=20
MAX_PENDING_JOBS_PER_USER=5
PENDING_JOB_TTL_SECONDS=1800

# Telegram file_id cache TTL: 90 days by default.
# Repeated links are resent by file_id without downloading again until this expires.
MEDIA_CACHE_TTL_SECONDS=7776000

# Telegram API mode.
# Cloud mode: leave TELEGRAM_API_BASE_URL and TELEGRAM_API_FILE_URL empty.
# Local mode: get TELEGRAM_API_ID/HASH at https://my.telegram.org/apps,
# start `docker compose --profile local-api up -d telegram-bot-api`, then set URLs below.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_API_PORT=8081
TELEGRAM_API_BASE_URL=
TELEGRAM_API_FILE_URL=

# Local Telegram Bot API example:
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=your_api_hash
# TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot{token}/{method}
# TELEGRAM_API_FILE_URL=http://telegram-bot-api:8081/file/bot{token}/{path}
# MAX_FILE_MB=2000
# MAX_DURATION_SECONDS=7200
# DOWNLOAD_TIMEOUT_SECONDS=3600
# JOB_TTL_SECONDS=7200
# MAX_URLS_PER_MESSAGE=5
# MAX_PENDING_JOBS_PER_CHAT=20
# MAX_PENDING_JOBS_PER_USER=5
# PENDING_JOB_TTL_SECONDS=1800

# yt-dlp runtime update watcher
YTDLP_UPDATE_INTERVAL_SECONDS=21600
YTDLP_UPDATE_POLL_SECONDS=10
YTDLP_RESTART_AFTER_UPDATE=false
YTDLP_BIN=/opt/ytdlp/yt-dlp

# Shared persistent data inside containers.
# Cookies are exported to /app/data/cookies/*.txt.
DATA_DIR=/app/data

# Optional auth browser / noVNC for login and cookies export.
# For local-only access keep AUTH_BROWSER_URL as http://127.0.0.1:33000/.
# For phone access use HTTPS reverse proxy or SSH reverse tunnel with Basic Auth.
AUTH_BROWSER_IMAGE_TAG=kasm
AUTH_BROWSER_PORT=33000
AUTH_BROWSER_URL=http://127.0.0.1:33000/
AUTH_BROWSER_USER=admin
AUTH_BROWSER_PASSWORD=replace_with_long_random_password
BROWSER_PROFILE_PATH=/browser-profile/.config/chromium

# Logging
LOG_LEVEL=INFO
